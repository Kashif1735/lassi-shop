{
  "version": 2,
  "functions": {
    "api/**/*.js": { "runtime": "nodejs20.x" }
  },
  "rewrites": [
    { "source": "/api/orders/:id/status", "destination": "/api/orders/[id]/status" },
    { "source": "/admin.html",            "destination": "/public/admin.html" },
    { "source": "/admin",                 "destination": "/public/admin.html" },
    { "source": "/css/:file*",            "destination": "/public/css/:file*" },
    { "source": "/js/:file*",             "destination": "/public/js/:file*" },
    { "source": "/images/:file*",         "destination": "/public/images/:file*" },
    { "source": "/((?!api/).*)",          "destination": "/public/index.html" }
  ]
}
